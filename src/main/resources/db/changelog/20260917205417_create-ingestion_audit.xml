<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260917205417_create-ingestion_audit" author="sena">
        <createTable tableName="ingestion_audit">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="RECEIVED">
                <constraints nullable="false"/>
            </column>
            <column name="total_lines_read" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="lines_processed" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="lines_with_error" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMP"/>
            <column name="error_message" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="20260917205417_idx_ingestion_audit_status" author="sena">
        <createIndex indexName="idx_ingestion_audit_status" tableName="ingestion_audit">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
